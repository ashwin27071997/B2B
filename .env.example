# ===========================================
# CLIENT CONFIGURATION (VITE)
# ===========================================

# Supabase Configuration
# Get these from https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ===========================================
# SERVER CONFIGURATION (Express)
# ===========================================

# Server port (default: 3001)
SERVER_PORT=3001

# Node environment
NODE_ENV=development

# Backend API Configuration
# The server layer forwards requests to this URL
BACKEND_API_URL=http://localhost:8000
BACKEND_API_KEY=your-backend-api-key
BACKEND_TIMEOUT=30000

# Supabase Service Key (for server-side operations)
# Get this from Supabase dashboard > Settings > API > service_role key
SUPABASE_SERVICE_KEY=your-service-role-key

# Supabase JWT Secret (for token verification)
# Get this from Supabase dashboard > Settings > API > JWT Secret
# CRITICAL: Required in production for secure JWT verification
SUPABASE_JWT_SECRET=your-jwt-secret

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Rate Limiting (optional)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
